{
  "schemaVersion": 1,
  "apps": [
    {
      "id": "uptime-kuma",
      "title": "Uptime Kuma",
      "description": "简单易用的自托管服务监控与状态通知工具",
      "tags": ["监控", "运维", "Web"],
      "image": "louislam/uptime-kuma:2.5.8",
      "ports": [
        {
          "container": 3001,
          "host": 3001,
          "web": true
        }
      ],
      "volumes": [
        {
          "container": "/app/data",
          "host": "data"
        }
      ],
      "environment": {
        "TZ": "Asia/Shanghai"
      }
    },
    {
      "id": "gitea",
      "title": "Gitea",
      "description": "轻量快速的自托管 Git 代码托管平台",
      "tags": ["开发", "Git", "协作"],
      "image": "docker.gitea.com/gitea:1.27.3",
      "ports": [
        {
          "container": 3000,
          "host": 3000,
          "web": true
        },
        {
          "container": 22,
          "host": 2222,
          "web": false
        }
      ],
      "volumes": [
        {
          "container": "/data",
          "host": "data"
        }
      ],
      "environment": {
        "TZ": "Asia/Shanghai"
      }
    },
    {
      "id": "vaultwarden",
      "title": "Vaultwarden",
      "description": "兼容 Bitwarden 客户端的轻量密码管理服务",
      "tags": ["安全", "密码", "Web"],
      "image": "vaultwarden/server:1.37.4",
      "ports": [
        {
          "container": 80,
          "host": 8081,
          "web": true
        }
      ],
      "volumes": [
        {
          "container": "/data",
          "host": "data"
        }
      ],
      "environment": {
        "TZ": "Asia/Shanghai"
      }
    },
    {
      "id": "freshrss",
      "title": "FreshRSS",
      "description": "支持多用户和扩展的自托管 RSS 阅读器",
      "tags": ["RSS", "阅读", "Web"],
      "image": "freshrss/freshrss:1.30.4",
      "ports": [
        {
          "container": 80,
          "host": 8082,
          "web": true
        }
      ],
      "volumes": [
        {
          "container": "/var/www/FreshRSS/data",
          "host": "data"
        }
      ],
      "environment": {
        "TZ": "Asia/Shanghai"
      }
    },
    {
      "id": "nginx",
      "title": "Nginx",
      "description": "高性能 HTTP 服务器与反向代理服务器",
      "tags": ["网络", "Web", "反向代理"],
      "image": "nginx:1.30.5-alpine",
      "ports": [
        {
          "container": 80,
          "host": 8080,
          "web": true
        }
      ]
    }
  ]
}
