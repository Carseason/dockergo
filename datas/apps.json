{
  "schemaVersion": 1,
  "apps": [
    {
      "id": "nginx",
      "title": "Nginx",
      "version": "20261113",
      "description": "高性能 HTTP 服务器与反向代理服务器",
      "tags": [
        "网络",
        "Web",
        "反向代理"
      ],
      "image": "nginx:latest",
      "d": true,
      "rm": false,
      "restart": "unless-stopped",
      "ports": [
        {
          "port": 8080,
          "target": 80,
          "desc": "默认端口"
        }
      ],
      "volumes": [
        {
          "target": "/usr/share/nginx/html",
          "type": "dir",
          "desc": "静态文件目录"
        }
      ]
    }
  ],
  "tags": [
    "网络",
    "Web",
    "反向代理"
  ]
}
