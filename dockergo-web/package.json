{
  "name": "dockergo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "data:generate": "node scripts/generate-apps.mjs",
    "test:data": "node --test scripts/generate-apps.test.mjs",
    "build:luci": "pnpm run data:generate && tsc -b && vite build --outDir ../luci-app-dockergo/htdocs/luci-static/resources/dockergo/app --emptyOutDir",
    "check": "tsc -b",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.20.0"
}
